# pstack kernel (keep the tag pinned; review the pstack changelog before upgrading)
PSTACK_REF=v0.5.1
PSTACK_APP_NAME=pstack-budget
PSTACK_DEBUG=true
PSTACK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PSTACK_DATABASE_URL=postgresql+asyncpg://budget:budget@db:5432/budget
PSTACK_REDIS_URL=redis://redis:6379/0
PSTACK_MODULES=users,budget
PSTACK_ADDONS_PATHS=addons,budget_addons
PSTACK_ADMIN_EMAIL=admin@example.com
PSTACK_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PSTACK_EXPOSE_DOCS=false

# Budget application.  Do not put a real password in this file or commit .env.
BUDGET_PASSWORD=replace-with-the-team-password
BUDGET_API_USER=api-client
BUDGET_SESSION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
BUDGET_DB_PATH=/app/data/budget2570.db
BUDGET_DOCS_PATH=/docs

# Web Watch state is stored in pstack's PostgreSQL database, not the read-only
# budget index mount. Its worker polls the public RSS feed at this interval and
# never bypasses Cloudflare Turnstile on the Process5 search page.
WATCH_INTERVAL_MINUTES=15

# Postgres bootstrap values. Keep these in sync with PSTACK_DATABASE_URL.
DB_NAME=budget
DB_USER=budget
DB_PASSWORD=replace-with-a-strong-database-password
